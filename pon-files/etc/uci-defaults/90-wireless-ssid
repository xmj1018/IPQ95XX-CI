#!/bin/sh
# 默认 SSID：HG5585F-2.4G / HG5585F-5G
# 关键：SSID/encryption/key 属于 wifi-iface 段（如 wireless.default_radio0），
#       不是 wifi-device 段（wireless.radio0）——写错段则 SSID 不生效。
# 做法：遍历每个 wifi-iface，通过 device 字段找到对应 radio 的 band，
#       据此设 2.4G/5G 的 SSID；同时解除对应 radio 的禁用。
# 兼容 band（新写法）与 hwmode（旧写法）。

[ -f /etc/config/wireless ] || exit 0

get_band() {
	local r="$1" b
	b=$(uci -q get "wireless.$r.band")
	[ -z "$b" ] && b=$(uci -q get "wireless.$r.hwmode")
	case "$b" in
		2g|11b|11g|11n) echo 2g ;;
		5g|11a|11ac|11ax) echo 5g ;;
		*) echo "" ;;
	esac
}

# 遍历所有 section，挑出 type=wifi-iface 的段
for s in $(uci show wireless 2>/dev/null | grep -oE '^wireless\.[A-Za-z0-9_]+=' | cut -d. -f2 | cut -d= -f1); do
	type=$(uci -q get "wireless.$s")
	[ "$type" = "wifi-iface" ] || continue

	dev=$(uci -q get "wireless.$s.device")
	mode=$(uci -q get "wireless.$s.mode")
	[ "$mode" = "ap" ] || [ -z "$mode" ] || continue

	band=$(get_band "$dev")
	[ -z "$band" ] && case "$dev" in
		*2g*|*2.4*) band=2g ;;
		*) band=5g ;;
	esac

	case "$band" in
		2g) ssid='HG5585F-2.4G' ;;
		5g) ssid='HG5585F-5G' ;;
		*) continue ;;
	esac

	uci set "wireless.$s.ssid=$ssid"
	uci set "wireless.$s.encryption=sae-mixed"
	uci set "wireless.$s.key=12345678"
	[ -n "$dev" ] && uci set "wireless.$dev.disabled=0"
done

uci commit wireless
exit 0
