# ============================================================
# PONWRT HG5585F-CT 定制增量配置
# 基线：上游 configs/an7581.config + configs/release.config（完全沿用，不改源码）
# 注意：目标平台与设备选择完全由上游 an7581.config 决定
#       （其中 CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct=y 已默认开启）
#       本文件只做追加：加 honk(BTF)、开 EIP93 AES 加速、argon 主题、小内存优化
# ============================================================

# ---------- honk 所需 BTF / eBPF 内核支持 ----------
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUP_BPF=y

# ---------- honk 插件（含 LuCI 界面与中文） ----------
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
# 注意：luci-app-honk 不走 luci.mk，中文翻译直接打进主包（honk.zh-cn.lmo），
# 不存在 luci-i18n-honk-zh-cn 子包，勿再添加
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_sqlite3-cli=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_coreutils-stat=y

# ---------- honk hook 链依赖（上游未声明，必须显式加入） ----------
# curl：honk rpcd 订阅探测 / 初始化 hook / 「维护→Geo数据」下载都依赖它，
#       PonWrt 底包不带，luci-app-honk 又没声明依赖 —— 不加则初始化直接报"缺少 curl 命令"
#       （对齐小米万兆 BE10000 固件：GENERAL.txt/PRIVATE.txt 里都有 curl+libcurl）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_bash=y

# ---------- 分区扩容 + 磁盘管理器（用户指定，对齐小米万兆固件） ----------
# partexp：系统→分区扩容，一键扩容 overlay 分区
#   依赖：fdisk block-mount bc blkid parted btrfs-progs losetup resize2fs e2fsprogs f2fs-tools kmod-loop
# diskman：系统→磁盘管理（sbwml 版），磁盘可视化
#   依赖：ucode block-mount parted smartmontools wipefs btrfs-progs dosfstools e2fsprogs
#         exfat-fsck exfat-mkfs f2fs-tools swap-utils xfs-mkfs
#         kmod-fs-exfat kmod-fs-f2fs kmod-fs-vfat kmod-fs-xfs
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_bc=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_wipefs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_swap-utils=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-xfs=y

# ---------- OpenClash（用户要求：可以不用但必须有）----------
# 用官方 luci feed 自带的版本（0.48.002，随 feeds install -a 就位），
# 与"刷新软件源能装到 OpenClash"一致，不另加 vernesong dev 第三方源。
# 依赖（官方版声明，全部已核实符号真实存在）：
#   luci-compat + dnsmasq-full + bash + curl + ca-bundle + ip-full
#   + ruby + ruby-yaml + kmod-inet-diag + kmod-nft-tproxy + kmod-tun + unzip
# 其中 curl/ca-bundle/ip-full/bash 已在上面，下面补齐其余。
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_dnsmasq-full=y
# dnsmasq-full 与默认 dnsmasq 互斥，须禁用默认精简版（OpenClash 标准做法）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_unzip=y

# ---------- AES 硬件加速（Airoha AN7581 EIP93） ----------
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-des=y

# ---------- argon 主题（字体沿用小米万兆固件） ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- iStoreOS 风格：iStore 应用商店 + 首页 ----------
# luci-app-store 显式依赖 libuci-lua + mount-utils（两者在 PonWrt 里都有定义）。
# 第一版 iStore 三件套整组丢失，疑似这两个依赖未被拉入 —— 这里显式写全，确保不再丢。
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y

# ---------- 小内存优化（HG5585F RAM 紧张） ----------
# zram 压缩内存当交换，等效扩内存（核心手段，不改上游 rootfs 结构）
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
# 体积优先编译（仅改 CFLAGS 优化级别，不动镜像结构）
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
# 精简：去掉不必要的大件
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_openssh-sftp-server=n
