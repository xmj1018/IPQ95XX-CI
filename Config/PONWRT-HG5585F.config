# ============================================================
# PONWRT HG5585F-CT 定制增量配置
# 基线：上游 configs/an7581.config + configs/release.config（完全沿用，不改源码）
# 本文件只做追加：选设备、加 honk(BTF)、开 EIP93 AES 加速、argon 主题
# ============================================================

# ---------- 目标平台与设备（仅编 HG5585F-CT） ----------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-ct=y

# ---------- honk 所需 BTF / eBPF 内核支持 ----------
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_CGROUP_BPF=y

# ---------- honk 插件（含 LuCI 界面与中文） ----------
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-i18n-honk-zh-cn=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_sqlite3-cli=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_coreutils-stat=y

# ---------- AES 硬件加速（Airoha AN7581 EIP93） ----------
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-des=y

# ---------- OAF 应用过滤（OpenAppFilter） ----------
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y

# ---------- argon 主题（字体沿用小米万兆固件） ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
