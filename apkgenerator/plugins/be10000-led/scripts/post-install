#!/bin/sh
# luci-app-be10000-led 安装后处理（纯界面，复用 xiaomi-control 上游后端）
# 后端由 luci-app-xiaomi-control（风扇包）或固件自带提供，本包不重复携带。

chmod 755 /etc/init.d/xiaomi-control 2>/dev/null || :
chmod 755 /usr/libexec/xiaomi-control.uc /usr/libexec/xiaomi-nfc.uc 2>/dev/null || :

rm -f /tmp/luci-indexcache* 2>/dev/null || :
rm -rf /tmp/luci-modulecache/* 2>/dev/null || :
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart >/dev/null 2>&1 || :

exit 0
