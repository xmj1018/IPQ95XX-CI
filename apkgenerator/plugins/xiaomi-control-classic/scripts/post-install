#!/bin/sh
# luci-app-xiaomi-control (BE10000 Fan & RGB 新界面版) 安装后处理
# 后端引用 OWRT 上游已生效的 xiaomi-control.uc（emc2305 PWM 风扇 + RGB ambient LED）。
# 本包为原版的升级替换：文件已由 apk 覆盖安装，这里只负责让服务跑起来。

# 1. 修正关键脚本可执行位（apk 解包可能丢位）
chmod 755 /etc/init.d/xiaomi-control 2>/dev/null || :
chmod 755 /usr/libexec/xiaomi-control.uc /usr/libexec/xiaomi-nfc.uc 2>/dev/null || :

# 2. 默认配置：已存在就完全不动（保护用户已调好的曲线/颜色）；缺失才由 apk 落地的为准
#    /etc/config/xiaomi-control 作为 conffile，apk 升级时会保留用户版本，无需处理。

# 3. 启用并启动后端守护（风扇 + RGB 真生效）
if [ -x /etc/init.d/xiaomi-control ]; then
	/etc/init.d/xiaomi-control enable >/dev/null 2>&1 || :
	/etc/init.d/xiaomi-control start  >/dev/null 2>&1 || :
fi

# 4. 让新菜单 / 新 ACL / 新界面立即生效
rm -f /tmp/luci-indexcache* 2>/dev/null || :
rm -rf /tmp/luci-modulecache/* 2>/dev/null || :
[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart >/dev/null 2>&1 || :

exit 0
