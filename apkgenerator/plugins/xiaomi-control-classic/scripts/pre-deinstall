#!/bin/sh
# 卸载处理：停止服务并恢复全速风扇 + 关灯，避免卸载后风扇停转/灯卡住。
# 注意：本包是原版 luci-app-xiaomi-control 的替换版，卸载本包即等于移除该控制器。

[ -x /etc/init.d/xiaomi-control ] && {
	/etc/init.d/xiaomi-control stop >/dev/null 2>&1 || :
	/etc/init.d/xiaomi-control disable >/dev/null 2>&1 || :
}

# 安全阀：风扇恢复满速，RGB 熄灭
for path in /sys/bus/i2c/devices/*-002f/hwmon/hwmon*/pwm1; do
	[ -e "$path" ] && echo 255 > "$path" 2>/dev/null || :
done
for path in /sys/class/leds/*:ambient/brightness; do
	[ -e "$path" ] && echo 0 > "$path" 2>/dev/null || :
done

rm -f /var/run/xiaomi-control.json /var/run/xiaomi-control.json.tmp 2>/dev/null || :
rm -f /tmp/luci-indexcache* 2>/dev/null || :
rm -rf /tmp/luci-modulecache/* 2>/dev/null || :

exit 0
